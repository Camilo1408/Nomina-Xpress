# ─── Base de datos (Turso) ───────────────────────────────────────
TURSO_DATABASE_URL=libsql://nomina-xpress-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJh...

# ─── Almacenamiento de logos (Cloudinary) ────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abc123xyz

# ─── Autenticación (NextAuth) ────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_de_32_chars
NEXTAUTH_URL=https://tu-proyecto.vercel.app

# ─── Auditoría: retención / purga ────────────────────────────────
# Meses que se conservan en AuditLog antes de purgar (por defecto 6).
AUDIT_RETENTION_MONTHS=6
# Secreto que protege la ruta de purga /api/cron/audit-purge.
# Vercel lo envía automáticamente al cron como "Authorization: Bearer <CRON_SECRET>".
# Genera con: openssl rand -base64 32
CRON_SECRET=cambia_esto_por_un_secreto_de_32_chars
