# ─── Base de datos (Turso) ───────────────────────────────────────
TURSO_DATABASE_URL=libsql://nomina-xpress-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJh...

# ─── Almacenamiento de logos (Cloudinary) ────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abc123xyz

# ─── Autenticación (NextAuth) ────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_de_32_chars
# Nombre alternativo que también acepta NextAuth v5; basta con una de las dos.
# AUTH_SECRET=
NEXTAUTH_URL=https://tu-proyecto.vercel.app

# ─── Backups (GitHub Actions secret, NO variable de Vercel) ─────
# Contraseña GPG para cifrar/descifrar los volcados semanales de Turso.
# Configúrala en: GitHub → Settings → Secrets and variables → Actions
# Genera con: openssl rand -base64 32  y guárdala en un gestor de contraseñas.
# BACKUP_GPG_PASSPHRASE=cambia_esto_por_una_passphrase_segura

# ─── Auditoría: retención / purga ────────────────────────────────
# Meses que se conservan en AuditLog antes de purgar (por defecto 6).
AUDIT_RETENTION_MONTHS=6
# Secreto que protege la ruta de purga /api/cron/audit-purge.
# Vercel lo envía automáticamente al cron como "Authorization: Bearer <CRON_SECRET>".
# Genera con: openssl rand -base64 32
CRON_SECRET=cambia_esto_por_un_secreto_de_32_chars

# ─── Notificaciones push (Web Push) ──────────────────────────────
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Integración con Inventory Xpress (opcional) ─────────────────
# Vacío o ausente = módulo de inventario OFF.
NEXT_PUBLIC_INVENTARIO_APP_URL=
# Dominio de la cookie de sesión compartida (p. ej. .cucinadeifiori.com).
# Sin definir = cookie host-only por defecto.
AUTH_COOKIE_DOMAIN=
# Secreto compartido del webhook /api/inventory-permissions/sync (cabecera x-sync-secret).
# Genera con: openssl rand -base64 32
NOMINA_SYNC_SECRET=

# ─── Scripts operativos (solo en tu terminal, NUNCA en Vercel ni en el repo) ──
# Contraseña para cada usuario que creen o reinicien los scripts de prisma/ y scripts/.
# Si falta, el script genera una aleatoria y la muestra una sola vez.
# NX_PASSWORD_<USUARIO>=
# Auditoría E2E contra un despliegue remoto (scripts/e2e-prod-audit.mjs):
# AUDIT_BASE_URL=
# AUDIT_USER=
# AUDIT_PASS=
# Permite correr una semilla de PRUEBA contra una base remota (solo instancias demo):
# NX_ALLOW_REMOTE_SEED=1
