generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  logoUrl        String?
  primaryColor   String   @default("#C1643F")
  secondaryColor String   @default("#8B6355")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users             User[]
  employees         Employee[]
  timeEntries       TimeEntry[]
  schedules         Schedule[]
  payAdjustments    PayAdjustment[]
  pushSubscriptions PushSubscription[]
  tipEntries        TipEntry[]
  bonuses           Bonus[]
  bonusAssignments  BonusAssignment[]
  discounts            Discount[]
  discountAssignments  DiscountAssignment[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String    @unique
  passwordHash String
  role         String    @default("EMPLOYEE")
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pushSubscriptions PushSubscription[]

  @@index([tenantId])
}

model Employee {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  documentId        String?
  phone             String?
  hourlyRateNormal  Float    @default(6400)
  hourlyRateSpecial Float    @default(11500)
  tipPercent        Float    @default(100)
  payType           String   @default("PAYROLL")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User?
  timeEntries      TimeEntry[]
  scheduleShifts   ScheduleShift[]
  payAdjustments   PayAdjustment[]
  tipDistributions TipDistribution[]
  bonusAssignments BonusAssignment[]
  discountAssignments DiscountAssignment[]

  @@index([tenantId])
}

model TimeEntry {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       String
  checkIn    DateTime
  checkOut   DateTime?
  checkIn2   DateTime?
  checkOut2  DateTime?
  isSpecial  Boolean   @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, date])
}

model Schedule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  weekStart String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts ScheduleShift[]

  @@index([tenantId])
}

model ScheduleShift {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String
  startTime  String
  endTime    String
  startTime2 String?
  endTime2   String?

  @@index([scheduleId])
  @@index([employeeId])
}

model PayAdjustment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String
  amount      Float
  description String
  periodStart String
  periodEnd   String
  createdAt   DateTime @default(now())

  @@index([tenantId, employeeId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model TipEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        String
  totalAmount Float
  menaje      Float
  netAmount   Float
  periodStart String
  periodEnd   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  distributions TipDistribution[]

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model TipDistribution {
  id             String    @id @default(cuid())
  tenantId       String
  tipEntryId     String
  tipEntry       TipEntry  @relation(fields: [tipEntryId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  hoursWorked    Float
  tipPercent     Float
  effectiveHours Float
  amount         Float
  createdAt      DateTime  @default(now())

  @@index([tenantId, employeeId])
  @@index([tipEntryId])
}

// Bono fijo configurable. Se calcula de forma stateless por período (quincena)
// del reporte, sin persistir aplicaciones — evita duplicados y no altera históricos.
model Bonus {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // STANDARD = mismo valor para todos | PER_EMPLOYEE = valor por asignación
  valueType      String   @default("STANDARD")
  // Valor del bono cuando valueType = STANDARD (ignorado en PER_EMPLOYEE)
  amount         Float    @default(0)
  // ALL | PAYROLL | SHIFT | SPECIFIC
  assignmentType String   @default("ALL")
  // BIWEEKLY | MONTHLY
  frequency      String   @default("BIWEEKLY")
  // Solo aplica si frequency = MONTHLY: FIRST | SECOND | SPLIT
  monthlyMode    String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments BonusAssignment[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// Membresía/valor por empleado. Necesaria para assignmentType = SPECIFIC
// (define a quién aplica) y para valueType = PER_EMPLOYEE (define el monto).
model BonusAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bonusId    String
  bonus      Bonus    @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Valor específico cuando el bono es PER_EMPLOYEE (null si STANDARD)
  amount     Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bonusId, employeeId])
  @@index([tenantId])
  @@index([bonusId])
  @@index([employeeId])
}

// Descuento fijo/personalizado. Resta del pago final. Mismo modelo de cálculo
// stateless por quincena que Bonus (evita duplicados, no altera históricos).
model Discount {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // STANDARD = mismo valor para todos | PER_EMPLOYEE = valor por asignación
  valueType      String   @default("STANDARD")
  amount         Float    @default(0)
  // ALL | PAYROLL | SHIFT | SPECIFIC
  assignmentType String   @default("ALL")
  // BIWEEKLY | MONTHLY
  frequency      String   @default("BIWEEKLY")
  // Solo aplica si frequency = MONTHLY: FIRST | SECOND | SPLIT
  monthlyMode    String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments DiscountAssignment[]

  @@index([tenantId])
  @@index([tenantId, active])
}

model DiscountAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Valor específico cuando el descuento es PER_EMPLOYEE (null si STANDARD)
  amount     Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([discountId, employeeId])
  @@index([tenantId])
  @@index([discountId])
  @@index([employeeId])
}
