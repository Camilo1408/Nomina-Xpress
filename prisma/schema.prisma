generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  logoUrl        String?
  primaryColor   String   @default("#C1643F")
  secondaryColor String   @default("#8B6355")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users             User[]
  employees         Employee[]
  timeEntries       TimeEntry[]
  schedules         Schedule[]
  payAdjustments    PayAdjustment[]
  pushSubscriptions PushSubscription[]
  tipEntries        TipEntry[]
  bonuses           Bonus[]
  bonusAssignments  BonusAssignment[]
  discounts            Discount[]
  discountAssignments  DiscountAssignment[]
  auditLogs            AuditLog[]
  customRoles          CustomRole[]
  userPermissions      UserPermission[]
  inventoryCategories  InventoryCategory[]
  holidays             Holiday[]
  contests             Contest[]
  contestItems         ContestItem[]
  contestItemResults   ContestItemResult[]
  contestTipReserves   ContestTipReserve[]
  contestBonuses       ContestBonus[]
  contestBonusPayments ContestBonusPayment[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String    @unique
  passwordHash String
  role         String    @default("EMPLOYEE")
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  // Rol personalizado creado por PROPRIETARY (complementa o reemplaza los permisos del role base)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  // Acceso al módulo de inventario (columna heredada, no usada en nómina)
  inventoryAccess Boolean @default(false)
  // Si false, es usuario solo del sistema (no aparece en nómina ni en listas de empleados pagables)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pushSubscriptions PushSubscription[]
  userPermissions   UserPermission[]

  @@index([tenantId])
}

model Employee {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  documentId        String?
  phone             String?
  hourlyRateNormal  Float    @default(6400)
  hourlyRateSpecial Float    @default(11500)
  tipPercent        Float    @default(100)
  payType           String   @default("PAYROLL")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User?
  timeEntries      TimeEntry[]
  scheduleShifts   ScheduleShift[]
  payAdjustments   PayAdjustment[]
  tipDistributions TipDistribution[]
  bonusAssignments BonusAssignment[]
  discountAssignments DiscountAssignment[]
  contestItemResults  ContestItemResult[]
  contestBonuses      ContestBonus[]

  @@index([tenantId])
}

model TimeEntry {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       String
  checkIn    DateTime
  checkOut   DateTime?
  checkIn2   DateTime?
  checkOut2  DateTime?
  isSpecial  Boolean   @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, date])
}

model Schedule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  weekStart String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts ScheduleShift[]

  @@index([tenantId])
}

model ScheduleShift {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String
  startTime  String
  endTime    String
  startTime2 String?
  endTime2   String?

  @@index([scheduleId])
  @@index([employeeId])
}

model PayAdjustment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String
  amount      Float
  description String
  periodStart String
  periodEnd   String
  createdAt   DateTime @default(now())

  @@index([tenantId, employeeId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model TipEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        String
  totalAmount Float
  menaje      Float
  netAmount   Float
  periodStart String
  periodEnd   String
  notes       String?
  // Suma de las reservas de concurso RESERVADAS de este día.
  // Invariante del módulo de concursos:
  //   totalAmount = menaje + contestReserved + netAmount
  // Las filas anteriores al módulo quedan en 0, por lo que su netAmount
  // sigue siendo exactamente totalAmount − menaje (histórico intacto).
  contestReserved Float @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  distributions   TipDistribution[]
  contestReserves ContestTipReserve[]

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model TipDistribution {
  id             String    @id @default(cuid())
  tenantId       String
  tipEntryId     String
  tipEntry       TipEntry  @relation(fields: [tipEntryId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  hoursWorked    Float
  tipPercent     Float
  effectiveHours Float
  amount         Float
  createdAt      DateTime  @default(now())

  @@index([tenantId, employeeId])
  @@index([tipEntryId])
}

// Bono fijo configurable. Se calcula de forma stateless por período (quincena)
// del reporte, sin persistir aplicaciones — evita duplicados y no altera históricos.
model Bonus {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // STANDARD = mismo valor para todos | PER_EMPLOYEE = valor por asignación
  valueType      String   @default("STANDARD")
  // Valor del bono cuando valueType = STANDARD (ignorado en PER_EMPLOYEE)
  amount         Float    @default(0)
  // ALL | PAYROLL | SHIFT | SPECIFIC
  assignmentType String   @default("ALL")
  // BIWEEKLY | MONTHLY
  frequency      String   @default("BIWEEKLY")
  // Solo aplica si frequency = MONTHLY: FIRST | SECOND | SPLIT
  monthlyMode    String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments BonusAssignment[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// Membresía/valor por empleado. Necesaria para assignmentType = SPECIFIC
// (define a quién aplica) y para valueType = PER_EMPLOYEE (define el monto).
model BonusAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bonusId    String
  bonus      Bonus    @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Valor específico cuando el bono es PER_EMPLOYEE (null si STANDARD)
  amount     Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bonusId, employeeId])
  @@index([tenantId])
  @@index([bonusId])
  @@index([employeeId])
}

// Descuento fijo/personalizado. Resta del pago final. Mismo modelo de cálculo
// stateless por quincena que Bonus (evita duplicados, no altera históricos).
model Discount {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // STANDARD = mismo valor para todos | PER_EMPLOYEE = valor por asignación
  valueType      String   @default("STANDARD")
  amount         Float    @default(0)
  // ALL | PAYROLL | SHIFT | SPECIFIC
  assignmentType String   @default("ALL")
  // BIWEEKLY | MONTHLY
  frequency      String   @default("BIWEEKLY")
  // Solo aplica si frequency = MONTHLY: FIRST | SECOND | SPLIT
  monthlyMode    String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments DiscountAssignment[]

  @@index([tenantId])
  @@index([tenantId, active])
}

model DiscountAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Valor específico cuando el descuento es PER_EMPLOYEE (null si STANDARD)
  amount     Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([discountId, employeeId])
  @@index([tenantId])
  @@index([discountId])
  @@index([employeeId])
}

// Roles personalizados creados por PROPRIETARY. Permiten definir conjuntos de
// permisos granulares sin tocar el código. Los permisos se almacenan como JSON.
model CustomRole {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  // JSON: string[] con claves de permiso (ej. ["time_entries:view","time_entries:create"])
  permissions String   @default("[]")
  // true = rol del sistema (no editable por PROPRIETARY, solo visible)
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// Permisos individuales asignados o denegados directamente a un usuario,
// independientemente del rol que tenga. Permite ajustes finos sin crear roles nuevos.
model UserPermission {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  // true = permiso adicional concedido | false = permiso denegado explícitamente
  granted       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([userId, permissionKey])
  @@index([tenantId, userId])
}

// Bitácora de auditoría — historial inmutable de acciones del sistema.
// Append-only: nunca se edita ni borra desde la app. Solo el rol PROPRIETARY
// puede consultarla. Los campos username/role son snapshots: persisten el valor
// al momento de la acción aunque el usuario se elimine después.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Nullable: en un login fallido el userId puede no aplicar
  userId      String?
  username    String
  role        String
  // CREATE | UPDATE | DELETE | ACTIVATE | DEACTIVATE | PUBLISH | UNPUBLISH |
  // EXPORT | PAYMENT | LOGIN | LOGOUT | LOGIN_FAILED
  action      String
  // AUTH | EMPLOYEES | TIME_ENTRIES | SCHEDULES | TIPS | PAYROLL |
  // PAY_ADJUSTMENTS | BONUSES | DISCOUNTS | CREDENTIALS | SETTINGS | PROFILE | INVENTORY
  module      String
  entityId    String?
  // Descripción legible del registro afectado (ej. nombre del empleado)
  entityLabel String?
  description String
  // Snapshots JSON serializados (string) del estado previo/nuevo en ediciones
  before      String?
  after       String?
  ip          String?
  userAgent   String?
  // SUCCESS | FAILURE
  result      String   @default("SUCCESS")
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, module])
  @@index([tenantId, userId])
}

// Espejo local de las categorías RAÍZ del sistema de inventario (que vive en
// otra base de datos / proyecto). Se sincroniza vía GET /api/categories del
// inventario. Es la fuente para: (a) generar las claves de permiso por categoría
// `inventory:daily:<slug>:<acción>` en la matriz de roles/usuarios, y (b) emitir
// esas claves en el JWT al iniciar sesión (cuando no se puede llamar al inventario).
model InventoryCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  active    Boolean  @default(true)
  syncedAt  DateTime @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

// Festivos personalizados por cliente. Complementan los festivos NACIONALES de
// la librería `date-holidays` (que solo conoce los fijados por la Ley Emiliani):
// permiten registrar festivos decretados localmente (municipales/departamentales)
// que la librería no incluye, para que la nómina los pague como día especial.
//
// La fecha se guarda en mes/día (+ año opcional) en lugar de un string ISO:
//   - year = null  → se repite CADA año ese mes/día (ej. fiesta patronal fija).
//   - year = 2026  → aplica SOLO a ese año (ej. decreto puntual).
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  month     Int      // 1-12
  day       Int      // 1-31
  year      Int?     // null = se repite cada año
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, year, month, day])
  @@index([tenantId])
}

// ─── Concursos e incentivos ───────────────────────────────────────────────────
// Concursos internos que premian a empleados por cumplir una meta. El premio NO
// lo asume la empresa: se financia descontando un porcentaje ADICIONAL del fondo
// bruto de propinas de los días del rango del concurso, encima del menaje del 10%.
//
// Invariante financiera, por día:
//   TipEntry.totalAmount = menaje + Σ(ContestTipReserve.amount) + netAmount
// El netAmount se obtiene por RESTA, nunca por porcentaje, para que la suma de
// las partes sea siempre exacta al peso independientemente del redondeo.
//
// Diseño completo en docs/superpowers/specs/2026-08-12-concursos-incentivos-design.md

model Contest {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Rango inclusive, formato YYYY-MM-DD (igual que TimeEntry.date y TipEntry.date)
  startDate   String
  endDate     String
  // BORRADOR | PROGRAMADO | ACTIVO | FINALIZADO | PAGADO | CANCELADO
  // Solo ACTIVO genera reservas sobre las propinas.
  status      String   @default("BORRADOR")
  // UNICO = todo en la quincena siguiente | DIVIDIDO = mitad en cada una de las dos siguientes
  payoutMode  String   @default("UNICO")

  activatedAt   DateTime?
  activatedById String?
  finalizedAt   DateTime?
  finalizedById String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ContestItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
}

// Ítem o premio dentro de un concurso. Cada uno tiene su propio porcentaje y su
// propia meta. Los ítems heredan el rango de fechas del concurso.
model ContestItem {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contestId   String
  contest     Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Meta a cumplir: valor numérico + unidad legible ("unidades", "COP", "botellas")
  goalValue   Float
  goalUnit    String  @default("unidades")
  // MAYOR_VALOR | MENOR_VALOR | PRIMERO_EN_ALCANZAR | SELECCION_MANUAL
  criteria    String  @default("MAYOR_VALOR")
  // Porcentaje del bruto diario de propinas destinado a este ítem. > 0 y <= 20
  percent     Float
  // GANADOR_UNICO | REPARTIDO (partes iguales entre los ganadores registrados)
  winnerMode  String  @default("GANADOR_UNICO")
  // PENDIENTE | ADJUDICADO | DESIERTO
  outcome     String  @default("PENDIENTE")

  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results  ContestItemResult[]
  reserves ContestTipReserve[]
  bonuses  ContestBonus[]

  @@unique([contestId, name])
  @@index([tenantId])
  @@index([contestId])
}

// Resultado registrado manualmente por participante. Necesario para evaluar el
// criterio (el ganador se determina comparando a TODOS) y para dejar rastro de
// quienes no ganaron.
model ContestItemResult {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contestItemId String
  contestItem   ContestItem @relation(fields: [contestItemId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  value         Float
  // Momento en que alcanzó la meta. Solo lo usa el criterio PRIMERO_EN_ALCANZAR.
  achievedAt    DateTime?
  notes         String?

  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([contestItemId, employeeId])
  @@index([tenantId])
  @@index([contestItemId])
}

// Registro de trazabilidad del dinero: una fila por (día × ítem).
// Los campos tipTotalAmount y percent son SNAPSHOTS congelados en el momento de
// reservar, no referencias: si el ítem cambia su porcentaje mañana, lo ya
// reservado no se mueve.
model ContestTipReserve {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Denormalizado desde contestItem.contestId para filtrar sin join
  contestId     String
  contestItemId String
  contestItem   ContestItem @relation(fields: [contestItemId], references: [id], onDelete: Cascade)
  tipEntryId    String
  // Cascade: si se borra la propina del día, la reserva deja de existir porque el
  // dinero del que salía ya no existe. El detalle queda en el AuditLog del borrado.
  tipEntry      TipEntry    @relation(fields: [tipEntryId], references: [id], onDelete: Cascade)
  // Denormalizado desde tipEntry.date para consultar por día sin join
  date          String

  tipTotalAmount Float
  percent        Float
  amount         Float
  // RESERVADA | DEVUELTA
  status         String    @default("RESERVADA")
  refundedAt     DateTime?
  refundReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipEntryId, contestItemId])
  @@index([tenantId])
  @@index([contestItemId, status])
  @@index([tenantId, date])
}

// Bono generado para un ganador. Todos los campos *Snapshot congelan el estado
// del concurso al adjudicar, de modo que una liquidación histórica nunca depende
// de la configuración vigente.
model ContestBonus {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contestId     String
  contestItemId String
  contestItem   ContestItem @relation(fields: [contestItemId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id])

  contestName      String
  itemName         String
  goalSnapshot     String   // ej. "240 unidades"
  criteriaSnapshot String
  percentSnapshot  Float
  // Base de propinas usada: Σ tipTotalAmount de los días con reserva del ítem
  tipBaseSnapshot  Float
  // Σ amount de las reservas RESERVADAS del ítem al momento de adjudicar
  reservedAmount   Float
  resultValue      Float
  periodStart      String
  periodEnd        String

  // Parte de reservedAmount que corresponde a este ganador (1 si GANADOR_UNICO)
  shareRatio  Float @default(1)
  totalAmount Float
  paidAmount  Float @default(0)
  // El saldo pendiente NO se persiste: es siempre totalAmount − paidAmount.
  // Una sola fuente de verdad evita que dos columnas se desincronicen.

  // PENDIENTE | PARCIAL | PAGADO | ANULADO
  status     String    @default("PENDIENTE")
  voidedAt   DateTime?
  voidReason String?

  assignedAt   DateTime @default(now())
  assignedById String?
  updatedAt    DateTime @updatedAt

  payments ContestBonusPayment[]

  @@unique([contestItemId, employeeId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

// Cuota de pago del bono (1 o 2 según payoutMode). El @@unique impide que existan
// dos cuotas con el mismo número: primera barrera contra el doble pago.
model ContestBonusPayment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contestBonusId String
  contestBonus   ContestBonus @relation(fields: [contestBonusId], references: [id], onDelete: Cascade)
  // Denormalizado desde contestBonus.employeeId: permite filtrar las cuotas de un
  // período por empleado sin join, en la query del reporte de nómina.
  employeeId     String
  installment    Int
  // Quincena destino
  periodStart    String
  periodEnd      String
  amount         Float
  // PENDIENTE | PAGADO | ANULADO
  status         String    @default("PENDIENTE")
  paidAt         DateTime?
  paidById       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestBonusId, installment])
  @@index([tenantId])
  @@index([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId, status])
}
